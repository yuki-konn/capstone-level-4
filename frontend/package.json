{
  "name": "capstone-level-4",
  "version": "1.0.0",
  "description": "Capstone Level 4",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "npx webpack server",
    "build": "npx webpack --mode=production",
    "test": "npx jest deleteAccount",
    "deploy": "npm run s3-upload && npm run update-cloudfront",
    "build-deploy": "npm run build && npm run s3-upload && npm run update-cloudfront",
    "--------------------": "---------------------------------------------------------",
    "s3-upload": "aws s3 cp ./dist/ s3://capstone-level-4/frontend/dist/ --recursive --exclude *.map",
    "update-cloudfront": "aws cloudfront create-invalidation --distribution-id E3BPTYXT9I14IP --paths \"/*\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.788.0",
    "@aws-sdk/lib-dynamodb": "^3.789.0",
    "axios": "^1.8.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.0",
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "jest": "^29.7.0",
    "sass": "^1.87.0",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "ts-node": "^10.9.2",
    "webpack": "^5.99.6",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1"
  }
}
